{
  "name": "wakebridge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "predev": "npm run build --workspace @wakebridge/shared",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "test": "npm run test --workspace @wakebridge/api",
    "db:generate": "npm run db:generate --workspace @wakebridge/api",
    "db:migrate": "npm run db:migrate --workspace @wakebridge/api",
    "test:e2e": "node scripts/integration.mjs",
    "test:native": "node scripts/integration.mjs --native",
    "test:relays": "node scripts/integration.mjs --relays"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "turbo": "2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
